# --- Paperless-ngx connection (required) ---
# Inside the devcontainer nothing else is running, so this points outwards:
# a Paperless on the container host is http://172.17.0.1:8000.
PAPERLESS_URL=http://paperless-ngx:8000
PAPERLESS_TOKEN=replace-with-your-paperless-api-token

# --- Transport ---
# stdio: the client (e.g. Claude Desktop) launches the server as a subprocess.
# http:  Streamable HTTP on PAPERLESS_MCP_HOST:PORT (what the Docker image runs).
PAPERLESS_MCP_TRANSPORT=stdio

# --- MCP server bind (http transport only) ---
# 127.0.0.1 by default; the container image overrides this with 0.0.0.0.
PAPERLESS_MCP_HOST=127.0.0.1
PAPERLESS_MCP_PORT=8000

# --- MCP bearer auth (http transport, strongly recommended) ---
# Clients must send: Authorization: Bearer <token>
# Leave empty to disable auth (only acceptable behind a trusted reverse proxy).
PAPERLESS_MCP_AUTH_TOKEN=

# --- Tool visibility flags ---
# When true, ALL write and delete tools are hidden.
PAPERLESS_MCP_READONLY=false
# When true (and readonly=false), delete tools are exposed. Default: off.
PAPERLESS_MCP_ENABLE_DELETE=false

# --- Connection tuning ---
# Set to false only for a Paperless instance with a self-signed certificate.
PAPERLESS_MCP_VERIFY_SSL=true
# Per-request HTTP timeout towards Paperless, in seconds.
PAPERLESS_MCP_TIMEOUT=30
# Tags, correspondents, document types, storage paths, custom fields and users
# are read once and cached, so every result can show names next to the IDs.
# This is how long that snapshot lives; renames made in the Paperless web UI
# show up after it expires. 0 caches forever (changes made through this server
# still refresh it immediately).
PAPERLESS_MCP_NAME_CACHE_TTL=300

# --- Limits ---
# Max bytes returned as base64 / image content by the download tools.
PAPERLESS_MCP_MAX_FILE_BYTES=25000000

# --- Logging (always written to stderr) ---
PAPERLESS_MCP_LOG_LEVEL=INFO
