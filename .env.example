# --- Paperless-ngx connection (required) ---
PAPERLESS_URL=http://paperless-ngx:8000
PAPERLESS_TOKEN=replace-with-your-paperless-api-token

# --- MCP server bind ---
PAPERLESS_MCP_HOST=0.0.0.0
PAPERLESS_MCP_PORT=8000

# --- MCP bearer auth (strongly recommended) ---
# Clients must send: Authorization: Bearer <token>
# Leave empty to disable auth (only acceptable behind a trusted reverse proxy).
PAPERLESS_MCP_AUTH_TOKEN=

# --- Tool visibility flags ---
# When true, ALL write and delete tools are hidden.
PAPERLESS_MCP_READONLY=false
# When true (and readonly=false), delete tools are exposed. Default: off.
PAPERLESS_MCP_ENABLE_DELETE=false

# --- Limits ---
# Max bytes returned as base64 in download/thumbnail tools.
PAPERLESS_MCP_MAX_FILE_BYTES=25000000
